parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    ignoreErrors:
        # Doctrine attribue l'identifiant $id par réflexion lors de l'INSERT
        # (GeneratedValue). Sans l'extension phpstan-doctrine, PHPStan ne le voit
        # pas : on ignore uniquement ce faux positif.
        - '#Property App\\Entity\\\w+::\$id \(int\|null\) is never assigned int so it can be removed from the property type\.#'