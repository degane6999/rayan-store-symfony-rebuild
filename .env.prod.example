# Modèle des secrets de production.
# Copier en .env.prod.local (ignoré par Git) et remplacer chaque valeur.
# Générer APP_SECRET avec : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=a_remplacer
DB_USER=rayan
DB_PASSWORD=a_remplacer_par_un_mot_de_passe_long
DB_ROOT_PASSWORD=a_remplacer_par_un_autre_mot_de_passe_long
MAILER_DSN=null://null
# Port HTTP exposé : 80 sur le serveur, 8080 pour un essai en local
HTTP_PORT=8080
