{% extends 'base.html.twig' %}
{% block title %}Rayan.store — High-tech en ligne{% endblock %}
{% block body %}
<section class="bg-gradient-to-r from-blue-600 to-blue-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
        <h1 class="text-4xl md:text-5xl font-bold font-display mb-4">La high-tech, simplement.</h1>
        <p class="text-blue-100 text-lg mb-8">Smartphones, laptops, gaming et accessoires au meilleur prix.</p>
        <a href="{{ path('app_catalog') }}" class="inline-block px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors">Découvrir le catalogue</a>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-2xl font-bold font-display mb-6">Nouveautés</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {% for product in featured %}
            {% include 'partials/_product_card.html.twig' %}
        {% else %}
            <p class="text-gray-500 col-span-4">Aucun produit pour le moment.</p>
        {% endfor %}
    </div>
</section>
{% endblock %}
