{% extends 'base.html.twig' %}
{% block title %}Connexion — Rayan.store{% endblock %}
{% block body %}
<div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-2xl font-bold font-display mb-6 text-center">Connexion</h1>
    {% if error %}
        <div class="bg-red-50 text-red-700 border border-red-200 rounded-lg px-4 py-3 text-sm mb-4">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post" class="space-y-4 bg-white p-6 rounded-2xl border border-gray-100">
        <div>
            <label class="block text-sm font-medium mb-1">Email</label>
            <input type="email" name="email" value="{{ last_email }}" required class="w-full px-3 py-2 border border-gray-200 rounded-lg">
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Mot de passe</label>
            <input type="password" name="password" required class="w-full px-3 py-2 border border-gray-200 rounded-lg">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Se connecter</button>
    </form>
    <p class="text-center text-sm text-gray-500 mt-4">Pas de compte ? <a href="{{ path('app_register') }}" class="text-blue-600 font-medium">S'inscrire</a></p>
</div>
{% endblock %}
