{% extends 'base.html.twig' %}
{% block title %}Panier — Rayan.store{% endblock %}
{% block body %}
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold font-display mb-6">Mon panier</h1>

    {% if cart.items|length == 0 %}
        <p class="text-gray-500">Votre panier est vide.</p>
        <a href="{{ path('app_catalog') }}" class="text-blue-600 font-medium">Voir le catalogue &rarr;</a>
    {% else %}
        <div class="bg-white rounded-2xl border border-gray-100 divide-y divide-gray-100">
            {% for item in cart.items %}
                <div class="flex items-center justify-between p-4">
                    <div>
                        <p class="font-medium">{{ item.product.name }}</p>
                        <p class="text-sm text-gray-500">{{ item.product.price|number_format }} € × {{ item.quantity }}</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <form method="post" action="{{ path('app_cart_update', {id: item.id}) }}" class="flex items-center gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart-update-' ~ item.id) }}">
                            <input type="number" name="quantity" value="{{ item.quantity }}" min="0" class="w-16 px-2 py-1 border border-gray-200 rounded-lg text-sm" onchange="this.form.submit()">
                        </form>
                        <form method="post" action="{{ path('app_cart_remove', {id: item.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cart-remove-' ~ item.id) }}">
                            <button type="submit" class="text-red-500 text-sm hover:underline">Retirer</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="flex items-center justify-between mt-6">
            <span class="text-xl font-bold">Total : {{ (cart.totalCents / 100)|number_format }} €</span>
            <a href="{{ path('app_checkout') }}" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">Passer commande</a>
        </div>
    {% endif %}
</div>
{% endblock %}
