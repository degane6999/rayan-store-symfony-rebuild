{% extends 'base.html.twig' %}
{% block title %}Espace vendeur — Rayan.store{% endblock %}
{% block body %}
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold font-display">Espace vendeur</h1>
        <a href="{{ path('app_seller_product_new') }}" class="px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">+ Nouveau produit</a>
    </div>
    <div class="bg-white rounded-2xl border border-gray-100 divide-y divide-gray-100">
        {% for product in products %}
            <div class="flex justify-between items-center p-4">
                <span>{{ product.name }}</span>
                <span class="text-sm text-gray-500">Stock : {{ product.stock }}</span>
                <span class="font-semibold">{{ product.price|number_format }} €</span>
            </div>
        {% else %}
            <p class="p-4 text-gray-500">Aucun produit.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}
