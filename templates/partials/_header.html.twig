<header class="sticky top-0 z-50 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

            <a href="{{ path('app_home') }}" class="flex items-center gap-2 group">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center group-hover:bg-blue-700 transition-colors">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                </div>
                <span class="font-bold text-xl text-gray-900 font-display">
                    Rayan<span class="text-blue-600">.store</span>
                </span>
            </a>

            <nav class="hidden md:flex items-center gap-1">
                <a href="{{ path('app_home') }}" class="px-3 py-2 text-sm font-medium rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">Accueil</a>
                <a href="{{ path('app_catalog') }}" class="px-3 py-2 text-sm font-medium rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors">Produits</a>
            </nav>

            <div class="flex items-center gap-2">
                <form action="{{ path('app_catalog') }}" method="get" class="hidden md:flex items-center gap-2">
                    <input type="text" name="q" placeholder="Rechercher..." value="{{ app.request.query.get('q') }}"
                           class="w-48 px-3 py-1.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </form>

                {% if app.user %}
                    <a href="{{ path('app_cart') }}" class="relative p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    </a>
                    <div class="relative group">
                        <button class="flex items-center gap-2 p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                            <div class="w-7 h-7 bg-blue-100 rounded-full flex items-center justify-center">
                                <span class="text-xs font-semibold text-blue-700">{{ app.user.firstName|slice(0,1)|upper }}</span>
                            </div>
                            <span class="hidden md:block text-sm font-medium text-gray-700 max-w-24 truncate">{{ app.user.firstName }}</span>
                        </button>
                        <div class="absolute right-0 top-full w-48 bg-white border border-gray-100 rounded-xl shadow-lg py-1 hidden group-hover:block">
                            <a href="{{ path('app_account') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Mon profil</a>
                            <a href="{{ path('app_orders') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Mes commandes</a>
                            {% if is_granted('ROLE_SELLER') %}<a href="{{ path('app_seller_dashboard') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Espace vendeur</a>{% endif %}
                            {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_admin_dashboard') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Administration</a>{% endif %}
                            <hr class="my-1 border-gray-100">
                            <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50">Se déconnecter</a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="hidden md:flex items-center gap-1.5 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                        Connexion
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</header>
