<div class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-gray-200 transition-all duration-200 flex flex-col">
    <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="relative block aspect-square overflow-hidden bg-gray-50 flex items-center justify-center">
        {% if product.imagePath %}
            <img src="{{ asset('images/' ~ product.imagePath) }}" alt="{{ product.name }}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        {% else %}
            <svg class="w-16 h-16 text-gray-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        {% endif %}
        {% if product.discountPercent %}
            <span class="discount-badge absolute top-2 left-2 bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">-{{ product.discountPercent }}%</span>
        {% endif %}
        {% if product.stock < 5 and product.stock > 0 %}
            <span class="absolute top-2 right-2 bg-orange-100 text-orange-700 text-xs font-medium px-2 py-0.5 rounded-full">Presque épuisé</span>
        {% endif %}
        {% if product.stock == 0 %}
            <div class="absolute inset-0 bg-gray-900/50 flex items-center justify-center">
                <span class="bg-white text-gray-800 text-sm font-semibold px-3 py-1 rounded-full">Rupture de stock</span>
            </div>
        {% endif %}
    </a>
    <div class="p-4 space-y-2 flex flex-col flex-1">
        <p class="text-xs font-medium text-blue-600 uppercase tracking-wide">{{ product.brand ?: product.category.name }}</p>
        <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="text-sm font-semibold text-gray-900 line-clamp-2 leading-snug hover:text-blue-600 transition-colors">{{ product.name }}</a>
        {% if product.averageRating %}
            {# Note calculée à partir des avis réellement déposés en base #}
            <div class="flex items-center gap-1" aria-label="Note {{ product.averageRating }} sur 5">
                <span class="text-xs">{% for i in 1..5 %}<span class="{{ i <= product.averageRating|round ? 'text-yellow-400' : 'text-gray-200' }}">★</span>{% endfor %}</span>
                <span class="text-xs text-gray-400">({{ product.reviewCount }})</span>
            </div>
        {% endif %}
        <div class="flex items-end justify-between gap-2 pt-1 mt-auto">
            <div class="flex flex-wrap items-baseline gap-x-1.5 min-w-0">
                <span class="text-lg font-bold text-gray-900 whitespace-nowrap">{{ product.price|number_format }} €</span>
                {% if product.discountPercent %}
                    <span class="text-sm text-gray-400 line-through whitespace-nowrap">{{ product.compareAtPrice|number_format }} €</span>
                {% endif %}
            </div>
            {% if app.user %}
                <form method="post" action="{{ path('app_cart_add', {slug: product.slug}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart-add') }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" {{ product.stock == 0 ? 'disabled' : '' }} class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 disabled:bg-gray-200 disabled:cursor-not-allowed text-white text-xs font-medium rounded-lg transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        Ajouter
                    </button>
                </form>
            {% else %}
                <a href="{{ path('app_login') }}" class="shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded-lg transition-colors">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    Ajouter
                </a>
            {% endif %}
        </div>
    </div>
</div>
