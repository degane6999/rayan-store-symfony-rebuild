<a href="{{ path('app_product_show', {slug: product.slug}) }}" class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-gray-200 transition-all duration-200 block">
    <div class="relative aspect-square overflow-hidden bg-gray-50 flex items-center justify-center">
        {% if product.imagePath %}
            <img src="{{ asset('images/' ~ product.imagePath) }}" alt="{{ product.name }}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
        {% else %}
            <svg class="w-16 h-16 text-gray-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        {% endif %}
        {% if product.stock < 5 and product.stock > 0 %}
            <span class="absolute top-2 right-2 bg-orange-100 text-orange-700 text-xs font-medium px-2 py-0.5 rounded-full">Presque épuisé</span>
        {% endif %}
        {% if product.stock == 0 %}
            <div class="absolute inset-0 bg-gray-900/50 flex items-center justify-center">
                <span class="bg-white text-gray-800 text-sm font-semibold px-3 py-1 rounded-full">Rupture de stock</span>
            </div>
        {% endif %}
    </div>
    <div class="p-4 space-y-2">
        <p class="text-xs font-medium text-blue-600 uppercase tracking-wide">{{ product.category.name }}</p>
        <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 leading-snug group-hover:text-blue-600 transition-colors">{{ product.name }}</h3>
        {% if product.averageRating %}
            <div class="flex items-center gap-1">
                <span class="text-xs text-yellow-500">★ {{ product.averageRating }}</span>
                <span class="text-xs text-gray-400">({{ product.reviewCount }})</span>
            </div>
        {% endif %}
        <div class="flex items-end justify-between pt-1">
            <span class="text-lg font-bold text-gray-900">{{ product.price }} €</span>
        </div>
    </div>
</a>
