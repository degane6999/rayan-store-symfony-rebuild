{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="rounded-lg px-4 py-3 text-sm font-medium {{ type == 'success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200' }}">
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}
