# Image de production de Rayan.store — construction en plusieurs étapes.
#   docker build -f Dockerfile.prod --target app -t rayan-store-app .   (PHP-FPM + code)
#   docker build -f Dockerfile.prod --target web -t rayan-store-web .   (Nginx + fichiers publics)
# Le Dockerfile de développement (Dockerfile) reste inchangé.

# --- Étape 1 : dépendances PHP, sans les outils de développement ---------------
FROM composer:2 AS vendor
ENV COMPOSER_ALLOW_SUPERUSER=1
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist \
        --no-interaction --no-progress --ignore-platform-reqs
COPY . .
# Génère aussi vendor/autoload_runtime.php (plugin symfony/runtime).
RUN composer dump-autoload --no-dev --classmap-authoritative

# --- Étape 2 : PHP-FPM, seul conteneur qui exécute le code --------------------
FROM php:8.4-fpm-alpine AS app
RUN apk add --no-cache icu-libs libzip \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev \
    && docker-php-ext-install pdo_mysql intl zip opcache \
    && apk del .build-deps
COPY docker/php/prod.ini /usr/local/etc/php/conf.d/zz-prod.ini

ENV APP_ENV=prod APP_DEBUG=0
WORKDIR /var/www/app
COPY --from=vendor /app /var/www/app
# Cache Symfony préparé à la construction ; les secrets sont fournis au démarrage.
RUN php bin/console cache:warmup --env=prod \
    && chown -R www-data:www-data var
USER www-data
EXPOSE 9000
CMD ["php-fpm"]

# --- Étape 3 : Nginx, reçoit les requêtes HTTP et sert les fichiers statiques --
FROM nginx:1.27-alpine AS web
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY public /var/www/app/public
EXPOSE 80
