{
    "name": "rayan/rayan-store",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/yaml": "6.4.*",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/asset": "6.4.*",
        "symfony/security-bundle": "6.4.*",
        "symfony/form": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/mailer": "6.4.*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "symfony/rate-limiter": "6.4.*",
        "symfony/var-exporter": "6.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/browser-kit": "6.4.*",
        "symfony/css-selector": "6.4.*",
        "symfony/phpunit-bridge": "6.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "process-timeout": 180
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "license": "proprietary"
}